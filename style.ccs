body {
  margin: 0;
  font-family: Arial, sans-serif;
}

/* Sidebar */
.sidebar {
  width: 200px;
  height: 100vh;
  background: #222;
  position: fixed;
  left: 0;
  top: 0;
  padding-top: 20px;
}

.sidebar a {
  display: block;
  color: white;
  padding: 15px;
  text-decoration: none;
}

.sidebar a:hover {
  background: #444;
}

/* Main page content */
.content {
  margin-left: 220px;
  padding: 40px;
}

/* Login page only */
.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/* Login box */
.login-container {
  width: 300px;
  text-align: center;
}

input {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
}

button {
  margin-top: 15px;
  padding: 10px 20px;
  cursor: pointer;
}
