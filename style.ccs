body {
  margin: 0;
  font-family: Arial, sans-serif;
  display: flex;
}

/* Sidebar */
.sidebar {
  width: 200px;
  height: 100vh;
  background: #222;
  position: fixed;
  left: 0;
  top: 0;
  padding-top: 20px;
}

.sidebar a {
  display: block;
  color: white;
  padding: 15px;
  text-decoration: none;
}

.sidebar a:hover {
  background: #444;
}

/* Main content */
.content {
  margin-left: 200px;
  padding: 40px;
  flex: 1;
}

/* Login page */
.login-container {
  width: 300px;
  margin: 100px auto;
  text-align: center;
}

input {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
}

button {
  margin-top: 15px;
  padding: 10px 20px;
  cursor: pointer;
}
